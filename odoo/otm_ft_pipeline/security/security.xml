<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_otm_ft" model="ir.module.category">
        <field name="name">FT Pipeline</field>
        <field name="sequence">60</field>
    </record>
    <record id="privilege_otm_ft" model="res.groups.privilege">
        <field name="name">FT Pipeline</field>
        <field name="category_id" ref="module_category_otm_ft"/>
    </record>

    <record id="group_ft_sales_manager" model="res.groups">
        <field name="name">Sales Manager</field>
        <field name="privilege_id" ref="privilege_otm_ft"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="group_ft_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_otm_ft"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <record id="group_ft_project_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="privilege_id" ref="privilege_otm_ft"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_ft_procurement" model="res.groups">
        <field name="name">Procurement</field>
        <field name="privilege_id" ref="privilege_otm_ft"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_ft_manufacturing" model="res.groups">
        <field name="name">Manufacturing (Factory)</field>
        <field name="privilege_id" ref="privilege_otm_ft"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_ft_accounts" model="res.groups">
        <field name="name">Accounts</field>
        <field name="privilege_id" ref="privilege_otm_ft"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
    </record>

    <!-- Non-sales stage owners must see the leads they act on (read only; writes go through the transition method). -->
    <record id="rule_crm_lead_ft_read_all" model="ir.rule">
        <field name="name">FT pipeline: stage owners read all leads</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ft_sales_manager')), (4, ref('group_ft_project_manager')), (4, ref('group_ft_procurement')), (4, ref('group_ft_accounts'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
